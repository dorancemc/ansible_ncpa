---

exclude_paths:
  - .ansible/
  - tests/roles/

skip_list:
  - name[play]

loop_var_prefix: "^(__|{role}_)"
var_naming_pattern: "^[a-z_][a-z0-9_]*$"

use_default_rules: true
offline: true
strict: false

enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - only-builtins
warn_list:
  - experimental
